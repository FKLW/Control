import numpy as np
import scipy as sp
import quadprog
import matplotlib.pyplot as plt
import control as ct

# ---------------- define system parameters ----------------
m = 1      # mass of the brick
b = 0.5    # damping coefficient
k = 1      # spring coefficient
# ----------------------------------------------------------

# ---------------- define the continue system ----------------
A = np.array([[0, 1],          # define state matrix A, n*n
              [-k/m, -b/m]])
n = len(A)                     # get the size of the first dimension
B = np.array([[0],             # define control matrix B, n*n
              [1/m]])
p = len(B[0])                  # get the size of the first dimension
C = np.eye(A.shape[0])
D = np.zeros((A.shape[0], B.shape[1]))
sys_c = ct.ss(A, B, C, D)      # establish the continue system
# ------------------------------------------------------------

# ---------------- acquire the discrete system ----------------
Ts = 0.1      # time interval
sys_d = ct.c2d(sys_c, Ts, method='zoh')      # 'zoh' zero-order holding
A = sys_d.A    # get the state matrix A for the discrete system
B = sys_d.B    # get the state matrix B for the discrete system
# -------------------------------------------------------------

# ---------------- initialize the system ----------------
x0 =  np.array([[0],      # initial state of the system
                [0]])
x = x0
u0 = np.array([[0]])      # initial input    
u = u0
u_pre = u0
xd =  np.array([[0],      # desired state of the system
                [0.2]])

# weights design
S =  np.array([[1, 0],      
               [0, 1]])
Q =  np.array([[1, 0],      
               [0, 1]])
R =  np.array([[0.1]])







